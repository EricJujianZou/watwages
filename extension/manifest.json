{
  "manifest_version": 3,
  "name": "WatWages",
  "description": "Puts the pay and applicants per opening for every WaterlooWorks posting on one sortable page. Not affiliated with UWaterloo.",
  "version": "0.2.4",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "panel/panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://waterlooworks.uwaterloo.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://waterlooworks.uwaterloo.ca/*"
      ],
      "js": [
        "src/content-loader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://waterlooworks.uwaterloo.ca/*"
      ],
      "js": [
        "src/adapter/bridge-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/contract.js",
        "src/content.js",
        "src/adapter/ww.js",
        "src/adapter/detail.js",
        "src/adapter/queue.js",
        "src/store/cache.js",
        "src/store/settings.js",
        "src/store/marks.js",
        "src/parse/pay.js",
        "src/parse/year.js",
        "src/parse/package.js",
        "src/parse/rules/pay.json",
        "src/parse/rules/year.json",
        "src/score/roi.js",
        "src/score/companies.js",
        "src/ui/overlay/overlay.js",
        "src/ui/overlay/format.js",
        "src/ui/overlay/icons.js",
        "src/ui/overlay/styles.js",
        "src/ui/overlay/*",
        "icons/logo-mark.png"
      ],
      "matches": [
        "https://waterlooworks.uwaterloo.ca/*"
      ]
    }
  ]
}
